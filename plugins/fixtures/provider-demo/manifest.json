{
  "schemaVersion": 1,
  "id": "com.acme.gateway",
  "name": "Acme Gateway",
  "version": "1.0.0",
  "description": "Declarative OpenAI-compatible provider fixture.",
  "author": "Acme",
  "apiVersion": 1,
  "engines": { "zylara": ">=0.11.0 <1.0.0" },
