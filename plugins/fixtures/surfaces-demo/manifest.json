{
  "schemaVersion": 2,
  "id": "com.acme.surfaces",
  "name": "Acme Surfaces",
  "version": "1.0.0",
  "description": "Trusted acceptance fixture: wraps the code workbench, replaces the settings page and adds a command palette action.",
  "author": "Acme",
  "apiVersion": 2,
  "engines": { "zylara": ">=0.12.0 <1.0.0" },
  "publisher": { "id": "acme", "name": "Acme", "keyId": "acme-fixture-2026" },
  "permissions": [
    "unsafe.renderer",
    "ui.override:code.workbench",
    "ui.override:settings.page",
    "ui.slot:palette.actions"
  ],
  "trusted": true,
  "contributes": {
    "ui": {
      "slots": [
        {
          "slot": "palette.actions",
          "id": "surface-check",
          "title": "Surfaces check",
          "icon": "Sparkles",
          "layouts": ["chat", "code", "agent"],
          "order": 10,
          "action": { "kind": "openSettings", "target": "plugins" }
        }
      ]
    }
  },
  "runtime": {
    "ui": "trusted",
    "entry": "main.js"
  }
}
