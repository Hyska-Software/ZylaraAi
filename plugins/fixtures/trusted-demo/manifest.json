{
  "schemaVersion": 2,
  "id": "com.acme.trusted-demo",
  "name": "Acme Trusted Lab",
  "version": "1.1.0",
  "description": "Trusted reference plugin: React page/panel, per-layout nav, variants, presets, GenUI and an agent tool.",
  "author": "Acme",
  "apiVersion": 2,
  "engines": { "zylara": ">=0.10.0 <1.0.0" },
  "publisher": { "id": "acme", "name": "Acme", "keyId": "acme-fixture-2026" },
  "permissions": [
    "unsafe.renderer",
    "ui.slot:chat.sidebar.footer",
    "ui.slot:chat.message.actions",
    "ui.view",
    "ui.nav",
    "ui.panel",
    "ui.command",
    "ui.variant",
    "ui.preset",
    "ui.genui",
    "ui.override:chat.welcome",
    "ui.override:layout.shell",
    "ui.css.global",
    "agent.tools",
    "agent.prompt",
    "agent.skills",
    "storage",
    "notifications",
    "providers"
  ],
  "trusted": true,
  "contributes": {
    "ui": {
      "slots": [
        {
          "slot": "chat.sidebar.footer",
          "title": "Trusted Lab",
          "titleKey": "toolbar.title",
          "icon": "Sparkles",
          "action": { "kind": "openView", "target": "lab" }
        }
      ],
      "views": [
        {
          "id": "lab",
          "title": "Trusted Lab",
          "titleKey": "views.lab",
          "description": "A React component running in the main webview.",
          "descriptionKey": "views.labDescription",
          "icon": "Sparkles",
          "layouts": ["chat", "code"],
          "order": 50,
          "component": "Lab"
        }
      ],
      "nav": [
        {
          "id": "lab",
          "title": "Trusted Lab",
          "titleKey": "views.lab",
          "icon": "Sparkles",
          "page": "lab",
          "layouts": ["chat", "code"],
          "order": 45
        }
      ],
      "panels": [
        {
          "id": "lab-panel",
          "title": "Trusted panel",
          "titleKey": "panels.lab",
          "icon": "PanelRight",
          "component": "LabPanel",
          "dock": "right",
          "tab": true,
          "layouts": ["chat", "code"],
          "order": 50
        }
      ],
      "variants": [
        {
          "component": "chat.message.user",
          "id": "glass",
          "title": "Glass",
          "layouts": ["chat"],
          "recipe": {
            "surface": "accent-soft",
            "radius": "xl",
            "padding": "3",
            "align": "end"
          }
        }
      ],
      "presets": [
        {
          "id": "paper",
          "title": "Paper",
          "layouts": ["chat", "code"],
          "tokens": {
            "light": { "background": "#faf8f4", "surface": "#f4efe7" },
            "dark": { "background": "#14120f", "surface": "#1d1a16" }
          },
          "density": "compact",
          "variants": { "chat.message.user": "glass" }
        }
      ],
      "genui": {
        "components": [
          {
            "id": "metric",
            "title": "Metric",
            "summary": "One KPI with a trend",
            "props": {
              "label": { "type": "text", "required": true, "maxChars": 40 },
              "value": { "type": "text", "required": true, "maxChars": 40 },
              "trend": { "type": "enum", "values": ["up", "down", "flat"] }
            },
            "render": { "kind": "trusted", "component": "MetricView" }
          }
        ]
      },
      "commands": [
        {
          "id": "open-lab",
          "title": "Open Trusted Lab",
          "titleKey": "commands.openLab",
          "command": "lab",
          "icon": "Sparkles",
          "action": { "kind": "openView", "target": "lab" }
        },
        {
          "id": "ping",
          "title": "Ping trusted handler",
          "titleKey": "commands.ping",
          "command": "trusted-ping",
          "action": { "kind": "execute", "method": "ping" }
        }
      ]
    },
    "tools": [
      {
        "name": "trusted_echo",
        "description": "Echo text through the trusted plugin runtime.",
        "risk": "read",
        "parameters": {
          "type": "object",
          "properties": {
            "text": { "type": "string" }
          },
          "required": ["text"]
        }
      }
    ],
    "promptSections": [
      { "id": "lab", "title": "Trusted Lab", "file": "prompt.md" }
    ],
    "skills": ["skills"],
    "locales": ["locales"],
    "providers": [
      {
        "id": "trusted-gateway",
        "name": "Trusted Lab Gateway",
        "shortName": "Trusted",
        "description": "Fixture declarative provider shipped by the trusted plugin.",
        "baseUrl": "https://api.trusted.example/v1",
        "models": [
          {
            "id": "trusted-chat-1",
            "name": "Trusted Chat 1",
            "protocols": ["openai-chat"],
            "contextWindow": 128000,
            "maxOutput": 8192
          }
        ]
      }
    ]
  },
  "runtime": {
    "ui": "trusted",
    "entry": "main.js"
  }
}
