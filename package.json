{
  "name": "zylara",
  "private": true,
  "version": "0.11.1",
  "type": "module",
  "description": "Zylara — chat desktop com harness de agentes, provedores OpenCode Go e Zen",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-catalog.mjs && tsc --noEmit && vite build",
    "build:fast": "node scripts/sync-catalog.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "node scripts/build-installer.mjs",
    "installer": "node scripts/build-installer.mjs",
    "installer:dry": "node scripts/build-installer.mjs --dry-run",
    "version:set": "node scripts/set-version.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "brand": "node scripts/build-brand.mjs",
    "verify:models": "node scripts/verify-models.mjs",
    "test": "vitest run",
    "test:scripts": "node --test scripts/__tests__/catalog-sources.test.mjs",
    "test:installer": "node --test scripts/installer/__tests__/shared.test.mjs scripts/installer/__tests__/config.test.mjs scripts/installer/__tests__/release.test.mjs scripts/installer/__tests__/version.test.mjs scripts/installer/__tests__/unix.test.mjs",
    "test:watch": "vitest",
    "i18n:check": "node scripts/check-i18n.mjs && node scripts/check-ui-copy.mjs && node scripts/check-rust-copy.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lobehub/icons-static-svg": "1.98.0",
    "@novnc/novnc": "^1.7.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "i18next": "^27.0.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.61.0",
    "material-icon-theme": "5.40.0",
    "mermaid": "^12.2.0",
    "motion": "^14.6.0",
    "pdfjs-dist": "^6.4.299",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
