{
  "schemaVersion": 1,
  "id": "__PLUGIN_ID__",
  "name": "__PLUGIN_NAME__",
  "version": "0.1.0",
  "apiVersion": 1,
  "description": "Sandboxed plugin generated by create-zylara-plugin.",
  "author": "Your name",
  "engines": { "zylara": ">=0.11.0 <1.0.0" },
  "publisher": { "id": "example", "name": "Example Publisher", "keyId": "dev-2026" },
  "permissions": [
    "ui.view",
    "ui.slot:chat.composer.toolbar",
    "agent.tools",
    "agent.skills",
    "storage"
  ],
  "contributes": {
    "ui": {
      "views": [
        {
          "id": "home",
          "title": "__PLUGIN_NAME__",
          "surface": "chat",
          "location": "sidebar",
          "entry": "ui/page.html"
        }
      ],
      "slots": [
        {
          "slot": "chat.composer.toolbar",
          "entry": "ui/toolbar.html",
          "title": "__PLUGIN_NAME__"
        }
      ]
    },
    "tools": [
      {
        "name": "lookup",
        "description": "Look up a value through this plugin backend.",
        "parameters": {
          "type": "object",
          "properties": { "query": { "type": "string" } },
          "required": ["query"]
        },
        "risk": "read",
        "profiles": ["chat", "code"]
      }
    ],
    "skills": ["skills"],
    "locales": ["locales"]
  },
  "runtime": {
    "ui": "sandbox",
    "backend": { "kind": "js", "entry": "backend/index.html" }
  }
}
