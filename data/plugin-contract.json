{
  "apiVersion": 1,
  "manifestSchemaVersion": 1,
  "name": "Zylara plugin contract",
  "description": "Single source of truth for plugin manifests, UI slots, permissions and runtime limits.",
  "toolNamePrefix": "plugin__",
  "toolNameMaxChars": 64,
  "limits": {
    "packageBytes": 52428800,
    "trustedPackageBytes": 209715200,
    "files": 2000,
    "unpackedBytes": 209715200,
    "promptCharsPerPlugin": 4000,
    "promptCharsTotal": 12000,
    "kvBytes": 5242880,
    "dataBytes": 104857600,
    "logBytes": 5242880,
    "networkBytes": 10485760,
    "rpcBytes": 1048576,
    "toolResultChars": 120000,
    "toolTimeoutSecs": 60
  },
  "slots": [
    { "id": "titlebar.actions", "title": "Title bar actions", "props": [], "modes": ["declarative", "sandbox", "trusted"] },
    { "id": "chat.sidebar.header", "title": "Chat sidebar header", "props": [], "modes": ["declarative", "sandbox", "trusted"] },
    { "id": "chat.sidebar.footer", "title": "Chat sidebar footer", "props": [], "modes": ["declarative", "sandbox", "trusted"] },
    { "id": "chat.header.actions", "title": "Chat header actions", "props": ["conversationId"], "modes": ["declarative", "sandbox", "trusted"] },
    { "id": "chat.composer.toolbar", "title": "Composer toolbar", "props": ["conversationId", "profile", "draft"], "modes": ["declarative", "sandbox", "trusted"] },
    { "id": "chat.welcome.actions", "title": "Welcome screen actions", "props": [], "modes": ["declarative", "sandbox", "trusted"] },
    { "id": "chat.message.actions", "title": "Message actions", "props": ["messageId", "role"], "modes": ["declarative", "sandbox", "trusted"] },
    { "id": "code.header.actions", "title": "Code header actions", "props": ["conversationId", "workspaceId"], "modes": ["declarative", "sandbox", "trusted"] },
    { "id": "code.panel.header", "title": "Code right panel header", "props": [], "modes": ["declarative", "sandbox", "trusted"] },
    { "id": "agent.sidebar.footer", "title": "Agents sidebar footer", "props": [], "modes": ["declarative", "sandbox", "trusted"] },
    { "id": "right.panel.header", "title": "Right panel header", "props": [], "modes": ["declarative", "sandbox", "trusted"] },
    { "id": "settings.plugins.header", "title": "Plugins settings header", "props": [], "modes": ["declarative", "sandbox", "trusted"] },
    { "id": "plugins.detail.actions", "title": "Plugin detail actions", "props": ["pluginId"], "modes": ["declarative", "sandbox", "trusted"] },
    { "id": "artifact.preview.toolbar", "title": "Artifact preview toolbar", "props": ["artifactId", "artifactKind", "mimeType"], "modes": ["declarative", "sandbox", "trusted"] }
  ],
  "components": [
    { "id": "layout.shell", "title": "Application shell", "props": ["children", "sidebar", "sidebarLabel", "rightPanel", "rightPanelOpen"] },
    { "id": "layout.center", "title": "Center workspace", "props": [] },
    { "id": "chat.welcome", "title": "Chat welcome screen", "props": [] },
    { "id": "settings.dialog", "title": "Settings dialog", "props": [] },
    { "id": "plugins.view", "title": "Plugins page", "props": [] }
  ],
  "permissions": [
    { "id": "ui.slot", "scoped": true, "risk": "low", "description": "Add host-rendered content to a named UI slot." },
    { "id": "ui.view", "scoped": false, "risk": "low", "description": "Register a page in a layout sidebar or center." },
    { "id": "ui.panel", "scoped": false, "risk": "low", "description": "Register a dockable side panel." },
    { "id": "ui.settings", "scoped": false, "risk": "low", "description": "Register a settings tab." },
    { "id": "ui.command", "scoped": false, "risk": "low", "description": "Register command palette and slash commands." },
    { "id": "ui.artifact", "scoped": false, "risk": "low", "description": "Register a viewer for artifact MIME types." },
    { "id": "ui.override", "scoped": true, "risk": "critical", "description": "Replace or wrap a host component. Trusted plugins only." },
    { "id": "ui.css.global", "scoped": false, "risk": "critical", "description": "Inject global CSS into the main webview. Trusted plugins only." },
    { "id": "ui.shell", "scoped": false, "risk": "critical", "description": "Replace the application shell. Trusted plugins only." },
    { "id": "ui.theme", "scoped": false, "risk": "low", "description": "Contribute declarative color themes." },
    { "id": "commands", "scoped": false, "risk": "low", "description": "Execute declarative commands registered by the plugin." },
    { "id": "hotkeys", "scoped": false, "risk": "medium", "description": "Register keyboard shortcuts." },
    { "id": "settings", "scoped": false, "risk": "low", "description": "Store plugin settings validated against its schema." },
    { "id": "agent.tools", "scoped": false, "risk": "high", "description": "Expose tools to the agent." },
    { "id": "agent.prompt", "scoped": false, "risk": "high", "description": "Inject instructions into the agent system prompt." },
    { "id": "agent.skills", "scoped": false, "risk": "high", "description": "Ship skills and scripts used by the agent." },
    { "id": "chat.read", "scoped": false, "risk": "high", "description": "Read conversations selected by the user." },
    { "id": "chat.write", "scoped": false, "risk": "high", "description": "Insert text into the composer draft." },
    { "id": "fs.read", "scoped": true, "risk": "high", "description": "Read files granted by a glob scope." },
    { "id": "fs.write", "scoped": true, "risk": "high", "description": "Write files granted by a glob scope." },
    { "id": "net", "scoped": true, "risk": "high", "description": "Perform HTTP requests to allowlisted hosts." },
    { "id": "process.spawn", "scoped": false, "risk": "critical", "description": "Run a native sidecar process. Trusted plugins only." },
    { "id": "secrets.use", "scoped": false, "risk": "medium", "description": "Use a namespaced secret through mediated HTTP without reading it." },
    { "id": "secrets.read", "scoped": false, "risk": "critical", "description": "Read a namespaced secret. Trusted plugins only." },
    { "id": "storage", "scoped": false, "risk": "low", "description": "Use plugin-scoped key/value storage." },
    { "id": "events", "scoped": true, "risk": "medium", "description": "Subscribe to normalized host events." },
    { "id": "clipboard.read", "scoped": false, "risk": "high", "description": "Read the system clipboard." },
    { "id": "notifications", "scoped": false, "risk": "low", "description": "Show desktop and in-app notifications." },
    { "id": "dialog", "scoped": false, "risk": "medium", "description": "Open native file dialogs." },
    { "id": "opener", "scoped": false, "risk": "medium", "description": "Open external links and folders." },
    { "id": "providers", "scoped": false, "risk": "high", "description": "Contribute an OpenAI-compatible model provider." },
    { "id": "unsafe.renderer", "scoped": false, "risk": "critical", "description": "Run JavaScript in the main webview. Trusted plugins only." }
  ]
}
