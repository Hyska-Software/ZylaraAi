{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zylara.app/schemas/plugin-manifest.schema.json",
  "title": "Zylara plugin manifest",
  "description": "Canonical manifest.json shipped inside a .zplugin package. The Rust validator in src-tauri/src/plugins/manifest.rs is authoritative; this schema mirrors it for editors and CI.",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "apiVersion", "publisher"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$",
      "maxLength": 128
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "apiVersion": { "type": "integer", "minimum": 1 },
    "description": { "type": "string", "maxLength": 4000 },
    "author": { "type": "string", "maxLength": 200 },
    "homepage": { "type": "string", "format": "uri" },
    "icon": { "type": "string", "maxLength": 256 },
    "trusted": { "type": "boolean", "default": false },
    "engines": {
      "type": "object",
      "properties": { "zylara": { "type": "string", "maxLength": 128 } },
      "additionalProperties": true
    },
    "publisher": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "keyId": { "type": "string", "maxLength": 128 },
        "homepage": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^(unsafe\\.renderer|ui\\.slot:[a-z0-9.]+|ui\\.override:[a-z0-9.]+|ui\\.view|ui\\.panel|ui\\.command|ui\\.settings|ui\\.theme|ui\\.artifact|ui\\.shell|ui\\.css\\.global|commands|hotkeys|chat\\.read|chat\\.write|opener|agents\\.read|agents\\.write|agent\\.tools|agent\\.prompt|agent\\.skills|providers|storage|settings|secrets\\.use|secrets\\.read|clipboard\\.read|notify|events|fs\\.read:.+|fs\\.write:.+|net:.+|process\\.spawn)$"
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "ui": { "enum": ["none", "declarative", "sandbox", "trusted"] },
        "entry": { "type": "string" },
        "backend": {
          "type": "object",
          "required": ["kind", "entry"],
          "properties": {
            "kind": { "const": "js" },
            "entry": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "contributes": {
      "type": "object",
      "properties": {
        "ui": {
          "type": "object",
          "properties": {
            "slots": { "type": "array", "items": { "$ref": "#/$defs/slot" } },
            "views": { "type": "array", "items": { "$ref": "#/$defs/view" } },
            "panels": { "type": "array", "items": { "$ref": "#/$defs/panel" } },
            "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } },
            "settingsTabs": { "type": "array", "items": { "$ref": "#/$defs/settingsTab" } },
            "themes": { "type": "array", "items": { "$ref": "#/$defs/theme" } }
          },
          "additionalProperties": false
        },
        "tools": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "$ref": "#/$defs/tool" } }
          ]
        },
        "promptSections": { "type": "array", "items": { "$ref": "#/$defs/promptSection" } },
        "skills": { "type": "array", "items": { "type": "string" } },
        "locales": { "type": "array", "items": { "type": "string" } },
        "providers": { "type": "array", "items": { "$ref": "#/$defs/provider" } },
        "artifactViewers": { "type": "array", "items": { "$ref": "#/$defs/artifactViewer" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "action": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["openView", "openPanel", "insertDraft", "openExternal", "execute"] },
        "target": { "type": "string" },
        "text": { "type": "string", "maxLength": 16000 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "method": { "type": "string" },
        "params": {}
      },
      "additionalProperties": false
    },
    "slot": {
      "type": "object",
      "required": ["slot"],
      "properties": {
        "slot": { "type": "string" },
        "entry": { "type": "string" },
        "title": { "type": "string" },
        "titleKey": { "type": "string" },
        "icon": { "type": "string" },
        "action": { "$ref": "#/$defs/action" },
        "declarative": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "required": ["id", "title", "surface", "location"],
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 120 },
        "titleKey": { "type": "string" },
        "description": { "type": "string", "maxLength": 2000 },
        "descriptionKey": { "type": "string" },
        "icon": { "type": "string" },
        "surface": { "enum": ["chat", "code", "agent", "global"] },
        "location": { "enum": ["main", "sidebar"] },
        "entry": { "type": "string" },
        "component": { "type": "string" }
      },
      "additionalProperties": false
    },
    "panel": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 120 },
        "titleKey": { "type": "string" },
        "icon": { "type": "string" },
        "entry": { "type": "string" },
        "component": { "type": "string" },
        "dock": { "enum": ["right"] }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": ["id", "title", "action"],
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 120 },
        "titleKey": { "type": "string" },
        "description": { "type": "string", "maxLength": 500 },
        "descriptionKey": { "type": "string" },
        "command": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
        "keywords": { "type": "string", "maxLength": 500 },
        "icon": { "type": "string" },
        "hotkey": { "type": "string", "maxLength": 80 },
        "action": { "$ref": "#/$defs/action" }
      },
      "additionalProperties": false
    },
    "settingsTab": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 120 },
        "titleKey": { "type": "string" },
        "icon": { "type": "string" },
        "entry": { "type": "string" },
        "component": { "type": "string" }
      },
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "required": ["id", "name", "light", "dark"],
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 120 },
        "light": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 200 } },
        "dark": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 200 } }
      },
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,31}$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "parameters": { "type": "object", "required": ["type"], "properties": { "type": { "const": "object" } } },
        "risk": { "enum": ["read", "network", "write", "shell"] },
        "profiles": { "type": "array", "items": { "enum": ["chat", "code"] }, "minItems": 1 },
        "timeoutSecs": { "type": "integer", "minimum": 1, "maximum": 600 }
      },
      "additionalProperties": false
    },
    "promptSection": {
      "type": "object",
      "required": ["id", "file"],
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 120 },
        "file": { "type": "string" }
      },
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "required": ["id", "name", "baseUrl", "models"],
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 120 },
        "shortName": { "type": "string", "maxLength": 40 },
        "description": { "type": "string", "maxLength": 2000 },
        "baseUrl": { "type": "string", "pattern": "^https://" },
        "consoleUrl": { "type": "string", "format": "uri" },
        "endpoints": { "type": "object", "additionalProperties": { "type": "string" } },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string", "maxLength": 128 },
              "name": { "type": "string", "maxLength": 120 },
              "protocols": { "type": "array", "items": { "const": "openai-chat" } },
              "contextWindow": { "type": "integer", "minimum": 1024 },
              "maxOutput": { "type": "integer", "minimum": 1 },
              "reasoning": { "type": "boolean" },
              "attachment": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "artifactViewer": {
      "type": "object",
      "required": ["id", "title", "mimeTypes", "entry"],
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 120 },
        "titleKey": { "type": "string" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "mimeTypes": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 120 } },
        "entry": { "type": "string" },
        "component": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
